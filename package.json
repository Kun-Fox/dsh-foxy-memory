{
  "name": "dsh-foxy-memory",
  "version": "0.4.0",
  "description": "Memory subplugin for dsh-foxy: local JSONL archive plus optional cross-platform Foxy Memory API, recall and search.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Kun-Fox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kun-Fox/dsh-foxy-memory.git"
  },
  "homepage": "https://github.com/Kun-Fox/dsh-foxy-memory#readme",
  "bugs": {
    "url": "https://github.com/Kun-Fox/dsh-foxy-memory/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "foxy",
    "memory",
    "livingmemory"
  ],
  "license": "MIT"
}









